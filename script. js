let cart = {};

function changeQty(name, price, change) {
    event.stopPropagation();

    if (!cart[name]) {
        cart[name] = {
            price: price,
            qty: 0
        };
    }

    cart[name].qty += change;

    if (cart[name].qty <= 0) {
        delete cart[name];
    }

    const qtyElement = document.getElementById("qty-" + name);

    if (qtyElement) {
        qtyElement.textContent = cart[name] ? cart[name].qty : 0;
    }

    updateCart();
}


function getCartTotal() {
    let total = 0;

    Object.values(cart).forEach(item => {
        total += item.price * item.qty;
    });

    return total;
}


function updateCart() {

    const basketItems = document.getElementById("basket-items");
    const basketTotal = document.getElementById("basket-total");

    if (!basketItems || !basketTotal) return;

    basketItems.innerHTML = "";

    const items = Object.entries(cart);

    if (items.length === 0) {

        basketItems.innerHTML = `
            <p>Your basket is empty</p>
        `;

        basketTotal.textContent = "0";
        return;
    }

    items.forEach(([name, item]) => {

        const row = document.createElement("div");

        row.className = "basket-item";

        row.innerHTML = `
            <div>
                <strong>${name}</strong>
                <p>₹${item.price} × ${item.qty}</p>
            </div>

            <div>
                <strong>₹${item.price * item.qty}</strong>

                <button
                    class="remove-item"
                    onclick="removeItem('${name}')">
                    🗑️
                </button>
            </div>
        `;

        basketItems.appendChild(row);
    });

    basketTotal.textContent = getCartTotal();
}


function removeItem(name) {

    delete cart[name];

    const qtyElement = document.getElementById("qty-" + name);

    if (qtyElement) {
        qtyElement.textContent = "0";
    }

    updateCart();
}

function orderOnWhatsApp() {

    const items = Object.entries(cart);

    if (items.length === 0) {
        alert("Please add items to your order first.");
        return;
    }

    let message = "🌶️ *Spicy Station Fast Food Order*%0A%0A";

    items.forEach(([name, item]) => {
        message += `${name} × ${item.qty} = ₹${item.price * item.qty}%0A`;
    });

    message += `%0A*Total: ₹${getCartTotal()}*`;

    const phone = "918117833787";

    window.open(
        `https://wa.me/${phone}?text=${message}`,
        "_blank"
    );
}


function showCategory(category) {

    const items = document.querySelectorAll(".menu-item");

    items.forEach(item => {

        if (
            category === "all" ||
            item.dataset.category === category
        ) {
            item.style.display = "block";
        } else {
            item.style.display = "none";
        }

    });
}


