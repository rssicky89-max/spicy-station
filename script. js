alert("SCRIPT LOADED"); 
cart = {};
const UPI_ID = "8117833787@YBL";
const BUSINESS_NAME = "Spicy Station Fast Food";

let selectedPayment = "";


// ==========================================
// WELCOME → MAIN APP
// ==========================================

function openMenu() {
    const welcome = document.getElementById("welcome");
    const mainApp = document.getElementById("main-app");

    if (welcome) {
        welcome.style.display = "none";
    }

    if (mainApp) {
        mainApp.style.display = "block";
        mainApp.style.visibility = "visible";
        mainApp.style.opacity = "1";
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    showCategory("all");
}


// ==========================================
// CATEGORY FILTER
// ==========================================

function showCategory(category) {
    const items = document.querySelectorAll(".menu-item");
    const buttons = document.querySelectorAll(".category");

    buttons.forEach(button => {
        button.classList.remove("active");

        const onclick = button.getAttribute("onclick");

        if (onclick && onclick.includes(`'${category}'`)) {
            button.classList.add("active");
        }
    });

    items.forEach(item => {
        const itemCategory = item.getAttribute("data-category");

        if (category === "all" || itemCategory === category) {
            item.style.display = "";
        } else {
            item.style.display = "none";
        }
    });
}


// ==========================================
// QUANTITY + / -
// ==========================================

function changeQty(name, price, change) {
    price = Number(price);
    change = Number(change);

    if (!cart[name]) {
        cart[name] = {
            price: price,
            qty: 0
        };
    }

    cart[name].qty += change;

    if (cart[name].qty < 0) {
        cart[name].qty = 0;
    }

    updateQuantityDisplay(name);
    updateBasket();
    updateBasketCount();
}


// ==========================================
// UPDATE QUANTITY DISPLAY
// ==========================================

function updateQuantityDisplay(name) {
    const element = document.getElementById("qty-" + name);

    if (!element) return;

    element.textContent = cart[name]
        ? cart[name].qty
        : "0";
}


// ==========================================
// BASKET COUNT
// ==========================================

function updateBasketCount() {
    const basketCount = document.getElementById("basket-count");

    if (!basketCount) return;

    let count = 0;

    Object.values(cart).forEach(item => {
        if (item.qty > 0) {
            count += item.qty;
        }
    });

    basketCount.textContent = count;
}


// ==========================================
// OPEN BASKET
// ==========================================

function openBasket() {
    const basketPanel = document.getElementById("basket-panel");

    if (!basketPanel) return;

    basketPanel.classList.add("show");

    updateBasket();
}


// ==========================================
// CLOSE BASKET
// ==========================================

function closeBasket() {
    const basketPanel = document.getElementById("basket-panel");

    if (!basketPanel) return;

    basketPanel.classList.remove("show");
}


// ==========================================
// UPDATE BASKET
// ==========================================

function updateBasket() {
    const basketItems = document.getElementById("basket-items");
    const basketTotal = document.getElementById("basket-total");

    if (!basketItems || !basketTotal) return;

    basketItems.innerHTML = "";

    let total = 0;
    let itemCount = 0;

    Object.entries(cart).forEach(([name, item]) => {

        if (item.qty <= 0) return;

        itemCount += item.qty;

        const itemTotal = item.price * item.qty;

        total += itemTotal;

        const div = document.createElement("div");

        div.className = "basket-item";

        div.innerHTML = `
            <div class="basket-item-info">

                <div class="basket-item-name">
                    ${escapeHTML(name)}
                </div>

                <div class="basket-item-price">
                    ₹${item.price} × ${item.qty}
                    = ₹${itemTotal}
                </div>

            </div>

            <div class="basket-qty">

                <button
                    onclick="changeQty('${escapeAttribute(name)}', ${item.price}, -1)">
                    −
                </button>

                <strong>${item.qty}</strong>

                <button
                    onclick="changeQty('${escapeAttribute(name)}', ${item.price}, 1)">
                    +
                </button>

            </div>
        `;

        basketItems.appendChild(div);
    });

    if (itemCount === 0) {
        basketItems.innerHTML = `
            <div class="empty-basket">
                🛒 Your basket is empty
                <br><br>
                Add some delicious food!
            </div>
        `;
    }

    basketTotal.textContent = total;

    updateBasketCount();
}


// ==========================================
// OPEN PAYMENT
// ==========================================

function openPayment() {
    const itemCount = getCartItemCount();

    if (itemCount === 0) {
        alert("Please add at least one item to your basket.");
        return;
    }

    const paymentPanel =
        document.getElementById("payment-panel");

    if (!paymentPanel) return;

    paymentPanel.classList.add("show");
}


// ==========================================
// CLOSE PAYMENT
// ==========================================

function closePayment() {
    const paymentPanel =
        document.getElementById("payment-panel");

    if (!paymentPanel) return;

    paymentPanel.classList.remove("show");
}


// ==========================================
// PAYMENT SELECTION
// ==========================================

function selectPayment(method) {
    selectedPayment = method;

    document
        .querySelectorAll(".payment-option")
        .forEach(button => {
            button.classList.remove("selected");
        });
}


// ==========================================
// UPI PAYMENT
// ==========================================

function payWithUPI() {
    const total = calculateTotal();

    if (total <= 0) {
        alert("Please add items to your basket first.");
        return;
    }

    selectedPayment = "UPI";

    const upiURL =
        "upi://pay" +
        "?pa=" + encodeURIComponent(UPI_ID) +
        "&pn=" + encodeURIComponent(BUSINESS_NAME) +
        "&am=" + encodeURIComponent(total) +
        "&cu=INR";

    window.location.href = upiURL;
}


// ==========================================
// COPY UPI
// ==========================================

function copyUPI() {

    if (navigator.clipboard) {

        navigator.clipboard
            .writeText(UPI_ID)
            .then(() => {
                alert("UPI ID copied: " + UPI_ID);
            })
            .catch(() => {
                fallbackCopy(UPI_ID);
            });

    } else {
        fallbackCopy(UPI_ID);
    }
}


function fallbackCopy(text) {

    const textarea =
        document.createElement("textarea");

    textarea.value = text;

    document.body.appendChild(textarea);

    textarea.select();

    document.execCommand("copy");

    textarea.remove();

    alert("UPI ID copied: " + text);
}


// ==========================================
// ORDER CONFIRMED
// ==========================================

function orderDone() {

    const itemCount = getCartItemCount();

    if (itemCount === 0) {
        alert("Your basket is empty.");
        return;
    }

    if (!selectedPayment) {
        selectedPayment = "Cash on Delivery";
    }

    closePayment();
    closeBasket();

    const orderStatus =
        document.getElementById("order-status");

    if (orderStatus) {

        orderStatus.classList.add("show");

        setTimeout(() => {

            orderStatus.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        }, 150);
    }

    alert(
        "Order confirmed! 🌶️\n\n" +
        "Payment: " + selectedPayment
    );
}


// ==========================================
// CALCULATE TOTAL
// ==========================================

function calculateTotal() {

    let total = 0;

    Object.values(cart).forEach(item => {

        if (item.qty > 0) {
            total += item.price * item.qty;
        }

    });

    return total;
}


// ==========================================
// CART ITEM COUNT
// ==========================================

function getCartItemCount() {

    let count = 0;

    Object.values(cart).forEach(item => {

        if (item.qty > 0) {
            count += item.qty;
        }

    });

    return count;
}


// ==========================================
// SAFE HTML
// ==========================================

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


function escapeAttribute(value) {

    return String(value)
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'");
}


// ==========================================
// PAGE INITIALIZATION
// ==========================================

document.addEventListener("DOMContentLoaded", function () {

    const welcome =
        document.getElementById("welcome");

    const mainApp =
        document.getElementById("main-app");

    // Welcome screen ON
    if (welcome) {
        welcome.style.display = "flex";
    }

    // Main app OFF
    if (mainApp) {
        mainApp.style.display = "none";
    }

    // Initial category
    showCategory("all");

    // Initial basket
    updateBasket();

    updateBasketCount();

});
